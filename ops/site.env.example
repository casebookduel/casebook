NODE_ENV=production
DUEL_DIR=/opt/casebook/m1/out
SITE_URL=https://casebookduel.com
NEXT_PUBLIC_X_URL=https://x.com/casebookduel
NEXT_PUBLIC_GITHUB_URL=https://github.com/casebookduel/casebook
# Seals (ops/README.md, Seals): the contract's address once it is deployed, and where the sealer keeps its records
SEAL_CONTRACT=
SEALS_FILE=/var/lib/casebook-seal/seals.jsonl
# Visitor cases (ops/README.md, Cases): 1 turns on /case. The model key should be its own OpenRouter key with a credit limit.
CASES_LIVE=
CASE_OPENROUTER_API_KEY=
CASE_FREE_PER_DAY=3
CASE_DAILY_USD=2
# Holder perk (on launch day): wallets holding HOLDER_MIN $CASE or more get HOLDER_CASES cases a day. 0 keeps it off.
HOLDER_MIN=0
HOLDER_CASES=20
# Built features opened one at a time after launch, comma-separated: trail,teach,skill,league. Empty: none open.
OPEN_FEATURES=
# Teach Holmes, once deployed (node scripts/lessons.mjs deploy <token> <fee> prints both)
LESSONS_CONTRACT=
LESSONS_FROM=
# The notebook league, once deployed (node scripts/lessons.mjs deploy-league <token> <fee> prints both)
LEAGUE_CONTRACT=
LEAGUE_FROM=
