{
  "name": "casebook-memory",
  "version": "0.1.0",
  "description": "Memory for coding agents with a receipt for every memory: uses, outcomes and measured uplift. MCP server and CLI, no dependencies.",
  "type": "module",
  "bin": {
    "casebook-memory": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "memory",
    "agents",
    "claude-code",
    "codex",
    "llm",
    "evaluation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casebookduel/casebook.git",
    "directory": "engine"
  },
  "homepage": "https://github.com/casebookduel/casebook/tree/main/engine#readme",
  "bugs": {
    "url": "https://github.com/casebookduel/casebook/issues"
  }
}
